# --- Pflicht -------------------------------------------------------------
# Adresse des Geraets, z. B. 192.168.1.50:5555 (adb tcpip 5555 muss einmal per USB gesetzt worden sein)
ADB_SERIAL=

# Hinweis: Fast alles hier laesst sich auch in der Weboberflaeche unter "Einstellungen"
# aendern. Gespeichert wird das dann in data/settings.json, und das ueberschreibt diese Datei.
# Ausgenommen sind BUTTON_LABELS, OCR_LANG, COIN_URL, APP_PACKAGE, ADB_PATH, DATA_DIR und
# LOG_LEVEL -- daran haengt die Erkennung, die bleibt bewusst nur hier einstellbar.

# --- Optional ------------------------------------------------------------
# Discord-Webhook fuer Meldungen (leer = nur Log-Ausgabe)
DISCORD_WEBHOOK_URL=

# Zeitfenster (lokale Zeit des Servers, im LXC am besten Europe/Berlin)
MORNING_START=07:00
MORNING_END=10:00
EVENING_START=19:00
EVENING_END=21:00

# Nicht starten, solange der Bildschirm des Geraets an ist (Geraet in Benutzung)
SKIP_IF_AWAKE=true
BUSY_RETRY_MIN=15
# Nach dieser Wartezeit wird trotz eingeschaltetem Bildschirm gestartet
BUSY_MAX_WAIT_MIN=120

# Wie lange pro Startversuch auf das Laden der Coin-Seite gewartet wird (langsame Geraete: hoeher)
PAGE_TIMEOUT_S=90
# Wie lange nach dem Tap auf die Bestaetigung gewartet wird
CONFIRM_TIMEOUT_S=25
# Zusaetzliche Startversuche (App neu starten), wenn die Seite nicht erkannt wurde
LAUNCH_RETRIES=1
# Moegliche Beschriftungen des Check-in-Buttons (kommagetrennt)
BUTTON_LABELS=Sammeln,Collect,Claim
OCR_LANG=deu

NOTIFY_ON_SUCCESS=true
NOTIFY_ON_ALREADY_DONE=false

DATA_DIR=./data
LOG_LEVEL=INFO

# --- Weboberflaeche (zweiter Dienst, laeuft automatisch mit) -------------
# Das Passwort steht bewusst NICHT hier: es wird beim ersten Aufruf der Seite vergeben und
# nur als Hash in data/web-password abgelegt.
WEB_PORT=80
# Tage, die vor dem ersten Lauf des Dienstes von Hand gesammelt wurden. Die Seite zeigt
# sonst nur die Serie aus der Datenbank und weicht von der App ab.
STREAK_OFFSET=0

# Nur aendern, falls AliExpress die Adresse der Coin-Seite aendert
# COIN_URL=https://m.aliexpress.com/p/coin-index/index.html?_immersiveMode=true&adc_manifest=coinindex&disableNav=true&from=newHp&wh_ttid=adc
# APP_PACKAGE=com.alibaba.aliexpresshd
