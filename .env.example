# --- Pflicht -------------------------------------------------------------
# Adresse des Geraets, z. B. 192.168.1.50:5555 (adb tcpip 5555 muss einmal per USB gesetzt worden sein)
ADB_SERIAL=

# Hinweis: Fast alles hier laesst sich auch in der Weboberflaeche unter "Einstellungen"
# aendern. Gespeichert wird das dann in data/settings.json, und das ueberschreibt diese Datei.
# Woran eine abgelaufene Anmeldung erkannt wird. Wird nur ausgewertet, wenn ohnehin weder der
# Sammeln-Knopf noch der Erledigt-Zustand gefunden wurde -- ein Treffer kann also nie einen
# erfolgreichen Lauf stoeren. Weglassen setzt die Vorgabe.
# LOGIN_MARKERS=anmelden,einloggen,anmeldung,sign in,log in

# Ausgenommen sind BUTTON_LABELS, OCR_LANG, COIN_URL, APP_PACKAGE, ADB_PATH, DATA_DIR und
# LOG_LEVEL -- daran haengt die Erkennung, die bleibt bewusst nur hier einstellbar.

# --- Optional ------------------------------------------------------------
# Discord-Webhook fuer Meldungen (leer = nur Log-Ausgabe)
DISCORD_WEBHOOK_URL=

# Zeitfenster (lokale Zeit des Servers, im LXC am besten Europe/Berlin)
MORNING_START=07:00
MORNING_END=10:00
EVENING_START=19:00
EVENING_END=21:00
# Abendlauf als Nachholversuch. Auf false steht nur der Morgenlauf zur Verfuegung -- dann darf
# das Morgenfenster auch irgendwo am Tag liegen, und EVENING_START/END bleiben ohne Wirkung.
EVENING_ENABLED=true

# Nicht starten, solange der Bildschirm des Geraets an ist (Geraet in Benutzung)
SKIP_IF_AWAKE=true
BUSY_RETRY_MIN=15
# Nach dieser Wartezeit wird trotz eingeschaltetem Bildschirm gestartet
BUSY_MAX_WAIT_MIN=120

# Wie lange pro Startversuch auf das Laden der Coin-Seite gewartet wird (langsame Geraete: hoeher)
PAGE_TIMEOUT_S=90
# Wie lange nach dem Tap auf die Bestaetigung gewartet wird
CONFIRM_TIMEOUT_S=25
# Zusaetzliche Startversuche (App neu starten), wenn die Seite nicht erkannt wurde
LAUNCH_RETRIES=1
# Moegliche Beschriftungen des Check-in-Buttons (kommagetrennt)
BUTTON_LABELS=Sammeln,Collect,Claim
OCR_LANG=deu

# Melden, wenn das Geraet laenger nicht erreichbar ist (je Ausfall eine Meldung, dazu eine
# Entwarnung). OFFLINE_ALERT_MIN ist die Wartezeit davor -- kurze Aussetzer sind normal.
# Wochenrueckblick montags um 9 Uhr (Quote, gesammelte Muenzen, Stand der letzten sieben Tage)
# Melden, wenn Erfolg gemeldet wird, der Muenzstand aber seit Tagen steht
NOTIFY_ON_STALL=true

NOTIFY_WEEKLY=true

NOTIFY_ON_OFFLINE=true
OFFLINE_ALERT_MIN=30

NOTIFY_ON_SUCCESS=true
NOTIFY_ON_ALREADY_DONE=false

# --- Akku ----------------------------------------------------------------
# Der Dienst liest Ladestand, Temperatur und Zustand des Akkus mit. Das ist ein reiner
# Lesezugriff: er weckt den Bildschirm nicht und tippt nichts an.
# Abstand zwischen zwei Abfragen. 0 schaltet das regelmaessige Nachsehen ab, dann zaehlt
# nur, was ein Lauf nebenbei mitbringt.
BATTERY_POLL_MIN=15
# Ab hier wird gewarnt: Ladestand darunter, Temperatur darueber.
BATTERY_LOW_PCT=25
BATTERY_HOT_C=40
# Meldet ausserdem, wenn das Geraet nicht mehr am Strom haengt oder einen Akkuschaden
# meldet. Die Warnung "haengt nicht am Strom" ist die einzige, die vor einem leeren Akku
# kommt -- danach ist auch die ADB-Verbindung weg und nur per USB wiederherstellbar.
NOTIFY_ON_BATTERY=true

# --- Home Assistant ueber MQTT (optional) --------------------------------
# Braucht einen Broker, etwa das Mosquitto-Add-on von Home Assistant. Gemeldet werden
# Ladestand, Temperatur, letzter Lauf, Muenzstand und Erreichbarkeit. Der Dienst schaltet
# dort nichts -- er liefert nur die Zahlen, das Schalten gehoert in eine Automatisierung.
# Ohne MQTT_HOST ist die Anbindung aus. Das Passwort ist ein Geheimnis.
# MQTT_HOST=homeassistant.local
MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# Derselbe Wert wie in Home Assistant unter MQTT eingestellt.
MQTT_DISCOVERY_PREFIX=homeassistant
# Namensanfang der Entitaeten: sensor.coin_collector_akku und so weiter.
HA_PREFIX=coin_collector

DATA_DIR=./data
LOG_LEVEL=INFO

# --- Weboberflaeche (zweiter Dienst, laeuft automatisch mit) -------------
# Das Passwort steht bewusst NICHT hier: es wird beim ersten Aufruf der Seite vergeben und
# nur als Hash in data/web-password abgelegt.
WEB_PORT=80
# Tage, die vor dem ersten Lauf des Dienstes von Hand gesammelt wurden. Die Seite zeigt
# sonst nur die Serie aus der Datenbank und weicht von der App ab.
STREAK_OFFSET=0

# Nur aendern, falls AliExpress die Adresse der Coin-Seite aendert
# COIN_URL=https://m.aliexpress.com/p/coin-index/index.html?_immersiveMode=true&adc_manifest=coinindex&disableNav=true&from=newHp&wh_ttid=adc
# APP_PACKAGE=com.alibaba.aliexpresshd
