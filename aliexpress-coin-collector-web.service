[Unit]
Description=AliExpress Coin Collector: Weboberflaeche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coins
WorkingDirectory=/opt/aliexpress-coin-collector
ExecStart=/opt/aliexpress-coin-collector/.venv/bin/python -m aliexpress_coin_collector.web
Restart=on-failure
RestartSec=30

# Port 80 ist privilegiert. Statt den Dienst als root laufen zu lassen, bekommt genau dieser
# Prozess das Recht, einen niedrigen Port zu belegen.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aliexpress-coin-collector/data

[Install]
WantedBy=multi-user.target
